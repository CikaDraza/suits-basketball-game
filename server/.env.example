# Server only. Never use VITE_* for these values.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
# Generate at least 32 random characters. This is a CLI developer credential, not browser auth.
MOTION_ANALYSIS_TOKEN=
# Optional for HTTP preparation; required only by the explicit provider check / future AI route.
OPENAI_API_KEY=
# Set an enabled model supporting Responses Structured Outputs. No model is substituted automatically.
OPENAI_MODEL=
OPENAI_MAX_OUTPUT_TOKENS=2048
