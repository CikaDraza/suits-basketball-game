{
  "name": "@suits/analysis-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "provider:check": "node --env-file-if-exists=.env --import tsx src/providerCheck.ts",
    "prepare:recording": "node --env-file-if-exists=.env --import tsx src/prepareRecording.ts",
    "compact:recording": "node --import tsx src/compactRecording.ts"
  },
  "dependencies": {
    "@suits/motion-contracts": "*",
    "express": "^5.3.0",
    "openai": "^7.55.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6"
  }
}
